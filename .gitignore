# === Security-critical: PII, secrets, exports must NEVER be committed ===
# Local data stores (contact PII, SQLite) — only .gitkeep is tracked.
data/**
db/**
exports/**
!data/.gitkeep
!db/.gitkeep
!exports/.gitkeep

# SQLite files anywhere
*.db
*.sqlite
*.sqlite3

# Secrets, env, credentials, OAuth tokens
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
!*.example
*token*.json
*oauth*.json
.mcp.json
!.mcp.json.example

# CSV exports (Apollo pulls, contact lists)
*.csv

# === Python ===
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# === OS / editor ===
.DS_Store
.idea/
.vscode/
