# Copy to .env and fill in. .env is gitignored — never commit real values.
# All example values here use example.com by policy (see tests/unit/test_no_pii_leak.py).

# --- Apollo (system of record; READ-ONLY from this tool). MCP OAuth is primary. ---
APOLLO_API_KEY=
APOLLO_SEED_LIST_ID=              # saved company list to ingest

# --- Local DB (gitignored) ---
SPINDLE_DB_PATH=db/spindle.db

# --- Outbound kill switch. false = outbound DISABLED (safe default in development). ---
OUTBOUND_ENABLED=false

# --- Sending (Phase 4). Leave blank until sending is set up. ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- Sender identity for compliance footer (physical postal address is legally required) ---
SENDER_NAME=
SENDER_COMPANY=
SENDER_POSTAL_ADDRESS=
UNSUBSCRIBE_URL=https://example.com/unsubscribe

# --- Dashboard export target (Phase 5) — sanitized, PII-free metrics only ---
DASHBOARD_EXPORT_URL=
DASHBOARD_EXPORT_TOKEN=
